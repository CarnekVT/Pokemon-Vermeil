{
  "id": "com.soysandi.interfaces",
  "name": "Editor de Interfaces",
  "version": "2.4.0",
  "authors": [
    {
      "name": "SoySandi"
    }
  ],
  "description": "Editor visual con biblioteca de interfaces en carpetas reales UI/<interfaz>/<pantalla>.json, navegación de subpantallas, propiedades sin saltos y conexión visual con Libreta/Pokédex nativas de Vermeil.",
  "homepage": "https://github.com/yobrantoro/ms-interfaces",
  "tags": [
    "essentials",
    "ui",
    "editor",
    "pokemon",
    "rpg-maker-xp"
  ],
  "apiVersion": "1.0.0",
  "main": "index.js",
  "permissions": [
    "fs.project",
    "fs.write.project",
    "ui.dialogs",
    "ui.toasts"
  ],
  "requires": [
    {
      "type": "plugin",
      "name": "Interfaces",
      "url": "https://github.com/yobrantoro/essentials-interfaces",
      "enforcement": "none"
    }
  ]
}
