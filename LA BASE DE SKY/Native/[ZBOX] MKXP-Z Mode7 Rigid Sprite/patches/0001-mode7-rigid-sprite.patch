diff --git a/shader/sprite.vert b/shader/sprite.vert
index 3fc3abc..49adfda 100644
--- a/shader/sprite.vert
+++ b/shader/sprite.vert
@@ -3,6 +3,16 @@ uniform mat4 projMat;
 
 uniform mat4 spriteMat;
 
+// Optional world-space projection for rigid 2.5D objects. The complete quad
+// shares one anchor/scale, so neighbouring map tiles cannot pull its rows.
+uniform bool mode7Rigid;
+uniform vec4 mode7World;       // world x/y, elevation, curve response
+uniform vec4 mode7Camera;      // camera x/y, screen centre x, pivot y
+uniform vec4 mode7Projection;  // radius, zoom, angle scale, ground y scale
+uniform vec4 mode7Curve;       // sine weight, linear weight, width strength, vertical scale
+uniform vec2 mode7SpriteOrigin;
+uniform vec2 mode7SpritePosition;
+
 uniform vec2 texSizeInv;
 uniform vec2 patternSizeInv;
 uniform vec2 patternScroll;
@@ -18,7 +28,32 @@ varying vec2 v_patCoord;
 
 void main()
 {
-	gl_Position = projMat * spriteMat * vec4(position, 0, 1);
+	vec4 screenPos = spriteMat * vec4(position, 0, 1);
+
+	if (mode7Rigid) {
+		float radius = max(mode7Projection.x, 1.0);
+		float theta = ((mode7World.y - mode7Camera.y - mode7Camera.w) *
+		               mode7Projection.y * mode7Projection.z * mode7Projection.w) / radius;
+		float curveY = mode7Curve.x * sin(theta) + mode7Curve.y * theta;
+		float denominator = max(0.25, 1.0 - mode7Curve.z * theta);
+		float directional = clamp(1.0 / denominator, 0.60, 1.50);
+		float scaleX = mode7Projection.y * directional;
+		float groundScale = mode7Projection.y * mode7Projection.z *
+		                    mode7Projection.w *
+		                    (mode7Curve.x * cos(theta) + mode7Curve.y);
+		float response = clamp(mode7World.w, 0.0, 1.0);
+		float scaleY = mix(scaleX, max(groundScale, 0.001), response);
+		vec2 projectedAnchor = vec2(
+			mode7Camera.z + (mode7World.x - mode7Camera.x) * scaleX,
+			mode7Camera.w + radius * curveY - mode7World.z * scaleY * mode7Curve.w
+		);
+		vec2 currentAnchor = (spriteMat * vec4(mode7SpriteOrigin, 0, 1)).xy;
+		vec2 viewportOffset = currentAnchor - mode7SpritePosition;
+		screenPos.xy = projectedAnchor + viewportOffset +
+		               (screenPos.xy - currentAnchor) * vec2(scaleX, scaleY);
+	}
+
+	gl_Position = projMat * screenPos;
     
     v_texCoord = texCoord * texSizeInv;
     
