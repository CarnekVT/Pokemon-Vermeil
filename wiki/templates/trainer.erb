<% e = locals[:entry]; title("#{e[:type_name]} #{e[:name]}") %>
<article class="detail trainer">
  <header>
    <% ts = tsprite(e[:trainer_type], hero: true) %>
    <% unless ts.empty? %><div class="hero-sprite hero-sprite--trainer"><%= ts %></div><% end %>
    <div class="headmeta">
      <h1><%= h(e[:type_name]) %> <%= h(e[:name]) %></h1>
      <% unless e[:items].empty? %><p class="muted">Objetos que usa: <%= h(e[:items].join(", ")) %></p><% end %>
      <% if e[:lose_text] && !e[:lose_text].empty? %><p class="quote">“<%= h(e[:lose_text]) %>”</p><% end %>
    </div>
  </header>

  <section class="section-card">
    <h2>Equipo <span class="count"><%= e[:party].size %></span></h2>
    <div class="party">
      <% e[:party].each do |p|
        form_id = p[:form].to_i.positive? ? "#{p[:species]}_#{p[:form]}" : p[:species]
        s = species(form_id) || species(p[:species])
        icon_id = s ? s[:id] : form_id
        display = p[:name].to_s.empty? ? (s ? display_name(s) : "Pokémon no registrado") : p[:name]
      %>
        <div class="pcard">
          <div class="top">
            <%= picon(icon_id, shiny: p[:shiny]) %>
            <div class="pcard-heading">
              <div class="nm"><%= h(display) %> <span class="lv">Nv. <%= p[:level] %></span></div>
              <% if s %><span class="types"><%= types_row(s[:types], small: true) %></span><% end %>
              <% if p[:shiny] %><span class="tag shiny-tag">Variocolor</span><% end %>
            </div>
          </div>
          <table class="kv small">
            <% if p[:ability] %><tr><th>Habilidad</th><td><%= h(p[:ability]) %></td></tr><% end %>
            <% if p[:item] %>
              <tr><th>Objeto</th><td><span class="held-item"><%= item_icon(p[:item_id], size: 28) %><%= h(p[:item]) %></span></td></tr>
            <% end %>
            <% if p[:nature] %><tr><th>Naturaleza</th><td><%= h(p[:nature]) %></td></tr><% end %>
            <% if p[:gender] %><tr><th>Género</th><td><%= h(p[:gender]) %></td></tr><% end %>
            <% if p[:ball] %><tr><th>Poké Ball</th><td><%= h(p[:ball]) %></td></tr><% end %>
            <% if p[:shadow] %><tr><th>Oscuro</th><td>sí</td></tr><% end %>
            <% if p[:iv]&.any? { |_, v| !v.nil? } %><tr><th>IVs</th><td class="stat-values"><%= h(stat_values(p[:iv])) %></td></tr><% end %>
            <% if p[:ev]&.any? { |_, v| v.to_i.positive? } %><tr><th>EVs</th><td class="stat-values"><%= h(stat_values(p[:ev], omit_zero: true)) %></td></tr><% end %>
          </table>
          <% unless p[:moves].empty? %>
            <ul class="trainer-moves">
              <% p[:moves].each do |move| %>
                <li class="trainer-move">
                  <div class="trainer-move__heading">
                    <a href="<%= page(:moves, move[:id]) %>"><%= h(move[:name]) %></a>
                    <span class="trainer-move__type">
                      <% if move[:type] %><%= type_tag(move[:type], small: true) %><% end %>
                      <% if move[:category_name] %><span class="tag"><%= h(move[:category_name]) %></span><% end %>
                    </span>
                  </div>
                  <div class="trainer-move__stats">
                    <span>Pot. <%= move[:power].to_i.zero? ? "—" : move[:power] %></span>
                    <span>Prec. <%= move[:accuracy].to_i.zero? ? "No falla" : move[:accuracy] %></span>
                    <span>PP <%= move[:total_pp] || "—" %></span>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%= change_box(e) %>
  <%= notes(e) %>
</article>
