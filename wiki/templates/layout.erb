<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(@title) %> · <%= h(meta[:game_title]) %></title>
<meta name="generator" content="Wiki generada el <%= h(meta[:generated]) %><%= " · #{meta[:version]}" if meta[:version] %>">
<link rel="stylesheet" href="<%= asset('style.css') %>">
<link rel="stylesheet" href="<%= asset('accent.css') %>">
<script>
(function () {
  try {
    var t = localStorage.getItem('wiki-theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch (e) {}
})();
</script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="<%= asset('index.html') %>"><%= h(meta[:game_title]) %></a>
  <nav aria-label="Secciones de la wiki">
    <% { "pokemon" => ["pokemon/index.html", "Pokédex"], "moves" => ["movimientos/index.html", "Movimientos"],
         "abilities" => ["habilidades/index.html", "Habilidades"], "items" => ["objetos/index.html", "Objetos"],
         "trainers" => ["entrenadores/index.html", "Entrenadores"], "locations" => ["ubicaciones/index.html", "Ubicaciones"],
         "types" => ["tipos.html", "Tipos"], "changes" => ["cambios.html", "Cambios"] }.each do |key, (href, label)|
         next unless feature?(key) %>
      <a href="<%= asset(href) %>"><%= label %></a>
    <% end %>
  </nav>
  <div class="tools">
    <input type="search" id="q" placeholder="Buscar en la wiki…" autocomplete="off" aria-label="Buscar en el contenido visible de la wiki">
    <button type="button" id="theme-toggle" aria-label="Tema oscuro" aria-pressed="false">
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
      </svg>
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.6 8.6 0 1 0 20.2 15.3Z"></path>
      </svg>
    </button>
  </div>
  <div id="results" hidden></div>
</header>
<main><%= content %></main>
<script>window.WIKI_ROOT = "<%= @root %>";</script>
<script src="<%= asset('buscar.js') %>"></script>
<script src="<%= asset('search.js') %>"></script>
<script src="<%= asset('filter.js') %>"></script>
<script src="<%= asset('trainer-variants.js') %>"></script>
<script src="<%= asset('sort-items.js') %>"></script>
<script src="<%= asset('sort-moves.js') %>"></script>
<script src="<%= asset('theme.js') %>"></script>
</body>
</html>
