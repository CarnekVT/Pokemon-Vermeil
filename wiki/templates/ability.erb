<% e = locals[:entry]; title(e[:name]) %>
<article class="detail ability">
  <header>
    <div class="headmeta">
      <h1><%= h(e[:name]) %><%= badge(e) %></h1>
      <p class="pokedex-entry"><%= h(e[:description]) %></p>
    </div>
  </header>

  <% if feature?("ability_pokemon") %>
  <section class="section-card">
    <h2>Pokémon con esta habilidad</h2>
    <% n = e[:pokemon][:normal].uniq; hid = e[:pokemon][:hidden].uniq; special = Array(e[:special_pokemon]).uniq %>
    <% if n.any? %><h3>Normal</h3><%= chiplist(n.map { |sp| mon_link(sp) }.join, n.size) %><% end %>
    <% if hid.any? %><h3>Oculta</h3><%= chiplist(hid.map { |sp| mon_link(sp) }.join, hid.size) %><% end %>
    <% if special.any? %><h3>Durante la teracristalización</h3><p class="muted">Se activa en combate cuando el Pokémon se teracristaliza.</p><%= chiplist(special.map { |sp| mon_link(sp) }.join, special.size) %><% end %>
    <% if n.empty? && hid.empty? && special.empty? %><p class="muted">Ningún Pokémon la tiene actualmente.</p><% end %>
  </section>
  <% end %>

  <%= change_box(e) %>
  <%= notes(e) %>
</article>
