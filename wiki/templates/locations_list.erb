<% title("Ubicaciones") %>
<h1>Ubicaciones <span class="count"><%= data[:locations].size %></span></h1>
<p class="lead">Mapas incluidos en el juego.</p>
<label class="page-search" for="page-search">Buscar en esta página
  <input id="page-search" type="search" placeholder="Escribe el nombre de una ubicación…" autocomplete="off">
</label>
<span id="list-count" class="muted" role="status"><%= data[:locations].size %> resultados</span>
<p class="muted" id="filter-empty" hidden>No se encontraron ubicaciones.</p>

<div class="table-scroll">
<table class="data">
  <thead><tr><th>Mapa</th><% if feature?("location_encounters") %><th>Encuentros</th><% end %><% if feature?("item_locations") && feature?("location_items") %><th class="num">Objetos</th><% end %></tr></thead>
  <tbody>
  <% data[:locations].each do |loc|
       encounter_data = loc[:encounters] if feature?("location_encounters")
       encounter_species = encounter_data&.flat_map { |enc| enc[:slots].map { |slot| species(slot[:species])&.dig(:name) } }
       item_names = (loc[:items].map { |found| item(found[:item])&.dig(:name) } if feature?("item_locations") && feature?("location_items"))
       search_text = page_search_text(loc[:name], encounter_data&.map { |enc| enc[:method_name] }, encounter_species, item_names) %>
    <tr data-page-search-entry data-search-text="<%= h(search_text) %>">
      <td><a href="<%= asset("ubicaciones/#{loc[:map]}.html") %>"><%= h(loc[:name]) %></a> <span class="muted">#<%= loc[:map] %></span></td>
      <% if feature?("location_encounters") %><td class="muted"><%= loc[:encounters].map { |e| e[:method_name] }.uniq.join(", ") %></td><% end %>
      <% if feature?("item_locations") && feature?("location_items") %><td class="num"><%= loc[:items].size.zero? ? "—" : loc[:items].size %></td><% end %>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
