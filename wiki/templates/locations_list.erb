<% title("Ubicaciones") %>
<h1>Ubicaciones <span class="count"><%= data[:locations].size %></span></h1>
<p class="lead">Mapas con Pokémon salvajes u objetos.</p>
<label class="page-search" for="page-search">Buscar en esta página
  <input id="page-search" type="search" placeholder="Escribe el nombre de una ubicación…" autocomplete="off">
</label>
<span id="list-count" class="muted" role="status"><%= data[:locations].size %> resultados</span>
<p class="muted" id="filter-empty" hidden>No se encontraron ubicaciones.</p>

<div class="table-scroll">
<table class="data">
  <thead><tr><th>Mapa</th><th>Encuentros</th><th class="num">Objetos</th></tr></thead>
  <tbody>
  <% data[:locations].each do |loc|
       encounter_species = loc[:encounters].flat_map { |enc| enc[:slots].map { |slot| species(slot[:species])&.dig(:name) } }
       item_names = loc[:items].map { |found| item(found[:item])&.dig(:name) }
       search_text = page_search_text(loc[:name], loc[:encounters].map { |enc| enc[:method_name] }, encounter_species, item_names) %>
    <tr data-page-search-entry data-search-text="<%= h(search_text) %>">
      <td><a href="<%= asset("ubicaciones/#{loc[:map]}.html") %>"><%= h(loc[:name]) %></a> <span class="muted">#<%= loc[:map] %></span></td>
      <td class="muted"><%= loc[:encounters].map { |e| e[:method_name] }.uniq.join(", ") %></td>
      <td class="num"><%= loc[:items].size.zero? ? "—" : loc[:items].size %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>
