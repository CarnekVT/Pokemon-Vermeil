<%
  title("Inicio")
  type_count = data[:types].values.count { |t| !t[:pseudo] }
%>
<section class="home-hero">
  <div class="home-intro">
    <p class="home-kicker">Guía para jugadores</p>
    <h1><%= h(meta[:game_title]) %><% if meta[:version] %> <span class="count">v<%= h(meta[:version]) %></span><% end %></h1>
    <p>Consulta los datos del juego, descubre dónde encontrar Pokémon y objetos y revisa qué cambió respecto a los juegos oficiales.</p>
    <p class="home-search-hint">Busca por nombre desde el campo de búsqueda de arriba.</p>
  </div>
  <div class="home-actions">
    <a class="home-action home-action--primary" href="<%= asset('pokemon/index.html') %>">
      <strong>Explorar Pokémon</strong><span><%= data[:species].size %> Pokémon y formas</span>
    </a>
    <a class="home-action" href="<%= asset('objetos/index.html') %>">
      <strong>Buscar objetos</strong><span><%= data[:items].size %> objetos y dónde encontrarlos</span>
    </a>
  </div>
</section>

<div class="home-grid">
  <section class="home-section">
    <h2>Explora el juego</h2>
    <ul class="home-links">
      <li><a href="<%= asset('movimientos/index.html') %>">Movimientos</a><span><%= data[:moves].size %></span></li>
      <li><a href="<%= asset('habilidades/index.html') %>">Habilidades</a><span><%= data[:abilities].size %></span></li>
      <li><a href="<%= asset('tipos.html') %>">Tabla de tipos</a><span><%= type_count %> tipos</span></li>
      <li><a href="<%= asset('ubicaciones/index.html') %>">Ubicaciones</a><span><%= data[:locations].size %> zonas</span></li>
      <li><a href="<%= asset('entrenadores/index.html') %>">Entrenadores</a><span><%= data[:trainers].size %></span></li>
    </ul>
  </section>

  <section class="home-section home-changes">
    <div class="home-section-heading">
      <div><h2>Diferencias con los juegos oficiales</h2>
        <% if changes[:empty] %>
          <p>No se detectaron diferencias respecto a <%= Render::View::BASELINE_LABEL %>.</p>
        <% else %>
          <p>Hay diferencias en varios datos del juego. Puedes revisarlas agrupadas por categoría.</p>
        <% end %>
      </div>
      <% unless changes[:empty] %><a class="home-change-link" href="<%= asset('cambios.html') %>">Ver cambios</a><% end %>
    </div>
    <% unless changes[:empty] %>
      <ul class="change-counts">
        <% count_labels = { "modificadas" => "Fichas con cambios", "nuevas" => "Añadidas", "eliminadas" => "No aparecen en el juego" } %>
        <% changes[:counts].each do |label, count| %>
          <li><strong><%= count %></strong><span><%= h(count_labels[label] || label.capitalize) %></span></li>
        <% end %>
      </ul>
    <% end %>
  </section>
</div>
